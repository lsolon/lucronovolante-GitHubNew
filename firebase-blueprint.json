{
  "entities": {
    "FixedCost": {
      "title": "Fixed Cost",
      "description": "A monthly fixed expense for the driver",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "item": { "type": "string" },
        "valorMensal": { "type": "number" },
        "diaVencimento": { "type": "number" },
        "dataInicio": { "type": "string", "description": "YYYY-MM" },
        "dataFim": { "type": "string", "description": "YYYY-MM" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Expense or earning category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "parentId": { "type": "string" }
      }
    },
    "MaintenanceInterval": {
      "title": "Maintenance Interval",
      "description": "Recommended interval for a maintenance item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "item": { "type": "string" },
        "intervaloKm": { "type": "number" }
      }
    },
    "AppSheetMapping": {
      "title": "AppSheet Mapping",
      "description": "Field mapping for AppSheet API",
      "type": "object",
      "properties": {
        "data": { "type": "string" },
        "tipo": { "type": "string" },
        "valor": { "type": "string" },
        "categoria": { "type": "string" },
        "km": { "type": "string" },
        "obs": { "type": "string" },
        "posto": { "type": "string" },
        "combustivel": { "type": "string" },
        "quantidade": { "type": "string" },
        "valorUnitario": { "type": "string" }
      }
    },
    "Message": {
      "title": "Campaign Message",
      "description": "A single message in an AI campaign",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "image": { "type": "string" },
        "video": { "type": "string" }
      }
    },
    "AICampaign": {
      "title": "AI Campaign",
      "description": "A collection of messages for an AI generation task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "$ref": "Message" }
        },
        "createdAt": { "type": "string" }
      }
    },
    "UserConfig": {
      "title": "User Configuration",
      "description": "Global settings for a specific driver",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User role" },
        "lastSeen": { "type": "string", "description": "ISO timestamp of last activity" },
        "visitCount": { "type": "number", "description": "Total number of visits" },
        "hasContributed": { "type": "boolean", "description": "True if user has added any data" },
        "fixedCosts": {
          "type": "array",
          "items": { "$ref": "FixedCost" },
          "description": "List of monthly fixed costs"
        },
        "categories": {
          "type": "array",
          "items": { "$ref": "Category" },
          "description": "Expense categories"
        },
        "earningCategories": {
          "type": "array",
          "items": { "$ref": "Category" },
          "description": "Earning platforms/categories"
        },
        "currentKm": {
          "type": "number",
          "description": "Last recorded odometer reading"
        },
        "targetKm": {
          "type": "number",
          "description": "Monthly mileage goal"
        },
        "dailyEarningGoal": {
          "type": "number",
          "description": "Daily earning target in R$"
        },
        "maintenanceIntervals": {
          "type": "array",
          "items": { "$ref": "MaintenanceInterval" },
          "description": "Maintenance items and their KM intervals"
        },
        "trialStartDate": {
          "type": "string",
          "description": "ISO timestamp of first login"
        },
        "appSheetMapping": {
          "$ref": "AppSheetMapping"
        }
      }
    },
    "AppConfig": {
      "title": "Application Configuration",
      "description": "Global settings for versioning and staging",
      "type": "object",
      "properties": {
        "publishedVersion": { "type": "string", "description": "Current stable version for all users" },
        "betaVersion": { "type": "string", "description": "Beta version for admins/testers" },
        "maintenanceMode": { "type": "boolean" },
        "announcement": { "type": "string" }
      }
    },
    "Entry": {
      "title": "Financial Entry",
      "description": "A single earning or expense record",
      "type": "object",
      "properties": {
        "data": { "type": "string", "format": "date", "description": "YYYY/MM/DD" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "tipo": { "type": "string", "enum": ["Ganhos", "Despesa"] },
        "categoriaId": { "type": "string" },
        "valor": { "type": "number" },
        "km": { "type": "number" },
        "kmRodado": { "type": "number" },
        "obs": { "type": "string" },
        "posto": { "type": "string" },
        "bandeiraPosto": { "type": "string" },
        "combustivel": { "type": "string" },
        "quantidade": { "type": "number" },
        "valorUnitario": { "type": "number" },
        "tanqueVazio": { "type": "boolean", "description": "Indica se o abastecimento foi feito com tanque vazio/reserva" },
        "referenciaMes": { "type": "string" },
        "manutencaoItem": { "type": "string" },
        "garantiaKm": { "type": "number" },
        "garantiaMeses": { "type": "number" },
        "photoUrl": { "type": "string" },
        "qrCodeData": { "type": "string" },
        "linkNota": { "type": "string" },
        "ganhos": { "type": "object", "description": "Breakdown of earnings by platform" },
        "reembolsos": { "type": "object", "description": "Breakdown of refunds by platform" }
      },
      "required": ["data", "tipo", "valor", "categoriaId"]
    },
    "GlobalStats": {
      "title": "Global Statistics",
      "description": "Application-wide metrics",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" },
        "uniqueVisitors": { "type": "number" },
        "lastUpdate": { "type": "string" }
      }
    },
    "BacklogItem": {
      "title": "Backlog Item",
      "description": "Idea or suggestion for future application updates",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] }
      },
      "required": ["text", "createdAt"]
    }
  },
  "firestore": {
    "/config/app": {
      "schema": "AppConfig",
      "description": "Global application configuration"
    },
    "/backlog/{itemId}": {
      "schema": "BacklogItem",
      "description": "Ideas and suggestions for the app"
    },
    "/stats/global": {
      "schema": "GlobalStats",
      "description": "Global application statistics"
    },
    "/users/{userId}": {
      "schema": "UserConfig",
      "description": "User-specific settings and configuration"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "Entry",
      "description": "Financial records for the user"
    },
    "/users/{userId}/campaigns/{campaignId}": {
      "schema": "AICampaign",
      "description": "AI generated marketing campaigns"
    }
  }
}
